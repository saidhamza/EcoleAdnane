# ===========================================================================
# Configuration des Secrets pour Streamlit Community Cloud
# À copier dans Streamlit Cloud -> Settings -> Secrets pour une connexion Google 1-clic fluide
# ===========================================================================

[google_oauth]
client_id = "VOTRE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "VOTRE_CLIENT_SECRET"
redirect_uri = "https://<votre-app>.streamlit.app"
