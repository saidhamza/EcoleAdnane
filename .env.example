# ===========================================================================
# Configuration Ecole Adnane - 3AC Révisions Collège Maroc
# ===========================================================================

# Clé API Google Gemini (Prioritaire - Palier 100% gratuit sans carte bancaire)
# Obtenez votre clé en 2 minutes sur : https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Clé API OpenAI (Optionnelle / Fallback)
OPENAI_API_KEY=

# Chemin vers la base de données SQLite (facultatif, défaut: storage/ecole_adnane.db)
DATABASE_PATH=storage/ecole_adnane.db

# ===========================================================================
# Authentification Google OAuth (Optionnel si credentials.json est présent)
# ===========================================================================
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:8501

